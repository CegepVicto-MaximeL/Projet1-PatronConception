@startuml
class Pnj {
  -etat : EtatPnj
  ~setEtat(etat)
  +parler()
  +donnerCadeau()
  +insulter()
}
interface EtatPnj {
  +parler()
  +donnerCadeau(pnj)
  +insulter(pnj)
  +getNom() : String
}
class Neutre
class Content
class Fache
Pnj o--> EtatPnj
EtatPnj <|.. Neutre
EtatPnj <|.. Content
EtatPnj <|.. Fache
@enduml
